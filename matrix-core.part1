      const p1 = a11*a22, p2 = a12*a21;
      const value = roundNumber(p1-p2);
      return {
        value,
        formula: 'det(A) = a₁₁a₂₂ − a₁₂a₂₁',
        steps: [
          `${fmt(a11)}·${fmt(a22)} − ${fmt(a12)}·${fmt(a21)}`,
          `${fmt(p1)} − ${fmt(p2)} = ${fmt(value)}`
